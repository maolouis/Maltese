{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Maltese",
  "version": "2.0.3",
  "identifier": "com.maolouis.maltese",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Maltese 线条小狗桌面助手",
        "width": 640,
        "height": 540,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/pet-gifs/**",
          "$APPDATA/plugins/**",
          "$RESOURCE/**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/maolouis/Maltese/releases/latest/download/latest.json",
        "https://ghfast.top/https://github.com/maolouis/Maltese/releases/latest/download/latest.json",
        "https://gh-proxy.com/https://github.com/maolouis/Maltese/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "maolouis",
    "copyright": "© 2026 maolouis",
    "targets": [
      "nsis"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    },
    "resources": {
      "../assets/pets": "assets/pets"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}